<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <RadioGroup
        android:id="@+id/theme_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RadioButton
            android:id="@+id/theme_follow_system_radio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_follow_system" />

        <RadioButton
            android:id="@+id/theme_dark_radio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_dark" />

        <RadioButton
            android:id="@+id/theme_light_radio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_light" />

        <RadioButton
            android:id="@+id/theme_pastel_radio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_pastel" />

        <RadioButton
            android:id="@+id/theme_deep_sea_radio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_deep_sea" />

        <RadioButton
            android:id="@+id/theme_retro_radio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_retro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/theme_custom_radio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/theme_custom" />

            <Button
                android:id="@+id/custom_theme_colors_button"
                style="@style/Widget.MangaTranslator.DialogActionButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:text="@string/custom_theme_colors_button" />
        </LinearLayout>
    </RadioGroup>
</ScrollView>
