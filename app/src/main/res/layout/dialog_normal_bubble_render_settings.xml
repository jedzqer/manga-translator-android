<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/normal_bubble_render_settings_note"
            android:textColor="?attr/dialogHintTextColor"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/normal_bubble_shrink_percent_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/normal_bubble_shrink_percent_input"
                style="@style/Widget.MangaTranslator.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/normal_bubble_opacity_percent_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/normal_bubble_opacity_percent_input"
                style="@style/Widget.MangaTranslator.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/normal_bubble_text_fill_percent_input"
            android:text="@string/normal_bubble_text_fill_percent_label"
            android:textColor="?attr/dialogTextColor" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bubble_text_fill_percent_range">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/normal_bubble_text_fill_percent_input"
                style="@style/Widget.MangaTranslator.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/normal_bubble_auto_adapt_color_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/normal_bubble_auto_adapt_color"
            android:textColor="?attr/dialogTextColor" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/normal_bubble_free_shrink_percent_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/normal_bubble_free_shrink_percent_input"
                style="@style/Widget.MangaTranslator.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/normal_bubble_free_opacity_percent_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/normal_bubble_free_opacity_percent_input"
                style="@style/Widget.MangaTranslator.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/normal_bubble_free_text_fill_percent_input"
            android:text="@string/normal_bubble_free_text_fill_percent_label"
            android:textColor="?attr/dialogTextColor" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bubble_text_fill_percent_range">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/normal_bubble_free_text_fill_percent_input"
                style="@style/Widget.MangaTranslator.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/normal_bubble_free_auto_adapt_color_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/normal_bubble_free_auto_adapt_color"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bubble_text_fill_percent_note"
            android:textColor="?attr/dialogHintTextColor"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/normal_bubble_vertical_text_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/bubble_vertical_text"
            android:textColor="?attr/dialogTextColor" />
    </LinearLayout>
</ScrollView>
