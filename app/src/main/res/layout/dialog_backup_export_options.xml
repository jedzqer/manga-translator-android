<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_export_options_hint"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/backup_include_manga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/backup_include_manga"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_include_manga_hint"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/backup_include_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/backup_include_settings"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_include_settings_hint"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
    </LinearLayout>
</ScrollView>
