<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    tools:ignore="TooManyViews">

    <!-- The library and detail surfaces share one binding for animated transitions. Their
         repeated content is already delegated to RecyclerViews; splitting the remaining
         controls behind a ViewStub would complicate binding lifecycle for little benefit. -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/library_list_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/library_selection_actions">

        <com.manga.translate.platform.SafeNestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/library_quick_actions_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface_card"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="18dp">

                        <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_quick_actions"
                        style="@style/Widget.MangaTranslator.SectionTab" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/library_quick_actions_title"
                        android:textAppearance="@style/Widget.MangaTranslator.CardTitle" />

                    <!-- Rows stretch both tiles to the taller label so long translations never overlap. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/import_ehviewer_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_action_tile"
                            android:gravity="center_vertical|start"
                            android:minHeight="64dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/import_ehviewer"
                            android:textAlignment="viewStart"
                            android:textAllCaps="false" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/import_cbz_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_action_tile"
                            android:gravity="center_vertical|start"
                            android:minHeight="64dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/import_cbz"
                            android:textAlignment="viewStart"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/floating_translate_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_action_tile"
                            android:gravity="center_vertical|start"
                            android:minHeight="64dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/floating_translate_button"
                            android:textAlignment="viewStart"
                            android:textAllCaps="false" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/tutorial_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_action_tile"
                            android:gravity="center_vertical|start"
                            android:minHeight="64dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/tutorial_button"
                            android:textAlignment="viewStart"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_surface_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_collection_label"
                        style="@style/Widget.MangaTranslator.SectionTab" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/library_collection_title"
                            android:textAppearance="@style/Widget.MangaTranslator.CardTitle" />

                        <LinearLayout
                            android:id="@+id/library_sort_control"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/library_sort_field"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:paddingStart="2dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="4dp"
                                android:paddingBottom="2dp"
                                android:text="@string/library_sort_by_time"
                                android:textAppearance="@style/Widget.MangaTranslator.BodyMuted"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/library_sort_order"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/library_sort_order_desc"
                                android:padding="4dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_sort_arrow_down" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/library_active_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_status_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="@style/Widget.MangaTranslator.BodyMuted"
                        android:textStyle="bold"
                        android:visibility="gone" />


                    <com.manga.translate.platform.BoundedRecyclerView
                        android:id="@+id/folder_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="96dp" />

                    <TextView
                        android:id="@+id/library_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/folder_empty"
                        android:textAppearance="@style/Widget.MangaTranslator.BodyMuted"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.manga.translate.platform.SafeNestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/folder_detail_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/folder_selection_actions">

        <com.manga.translate.platform.SafeNestedScrollView
            android:id="@+id/folder_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="beforeDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/folder_detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface_card"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_action_panel_label"
                        style="@style/Widget.MangaTranslator.SectionTab" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            style="?attr/buttonBarStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/folder_add_images"
                                style="@style/Widget.MangaTranslator.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/folder_add_images" />

                            <Button
                                android:id="@+id/folder_read"
                                style="@style/Widget.MangaTranslator.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="@string/folder_read" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/folder_collection_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:visibility="gone">

                            <LinearLayout
                                style="?attr/buttonBarStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/folder_collection_add_chapter"
                                    style="@style/Widget.MangaTranslator.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/folder_add_chapter" />

                                <Button
                                    android:id="@+id/folder_import_chapters"
                                    style="@style/Widget.MangaTranslator.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/folder_import_chapters" />
                            </LinearLayout>

                            <LinearLayout
                                style="?attr/buttonBarStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/folder_export_collection"
                                    style="@style/Widget.MangaTranslator.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/folder_export_collection" />

                                <Button
                                    android:id="@+id/folder_translate_collection"
                                    style="@style/Widget.MangaTranslator.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/folder_translate" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/folder_collection_read"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/folder_read" />
                        </LinearLayout>

                        <LinearLayout
                            style="?attr/buttonBarStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_marginTop="8dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/folder_translate"
                                style="@style/Widget.MangaTranslator.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/folder_translate" />

                            <Button
                                android:id="@+id/folder_export"
                                style="@style/Widget.MangaTranslator.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="@string/folder_export" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folder_translation_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/folder_translation_settings_title"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:text="@string/folder_translation_settings"
                            android:textAppearance="@style/Widget.MangaTranslator.CardTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_soft_panel"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/folder_full_translate_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:labelFor="@id/folder_full_translate_switch"
                            android:text="@string/folder_full_translate" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/folder_full_translate_info"
                            style="@style/Widget.MangaTranslator.HelpButton"
                            android:contentDescription="@string/folder_full_translate_info_desc" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/folder_full_translate_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:contentDescription="@string/folder_full_translate" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_soft_panel"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/folder_glossary_processing_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:labelFor="@id/folder_glossary_processing_switch"
                            android:text="@string/folder_glossary_processing" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/folder_glossary_processing_info"
                            style="@style/Widget.MangaTranslator.HelpButton"
                            android:contentDescription="@string/folder_glossary_processing_info_desc" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/folder_glossary_processing_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:contentDescription="@string/folder_glossary_processing" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_soft_panel"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/folder_vl_direct_translate_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:labelFor="@id/folder_vl_direct_translate_switch"
                            android:text="@string/folder_use_vl_direct_translate" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/folder_vl_direct_translate_info"
                            style="@style/Widget.MangaTranslator.HelpButton"
                            android:contentDescription="@string/folder_use_vl_direct_translate_info_desc" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/folder_vl_direct_translate_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:contentDescription="@string/folder_use_vl_direct_translate" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/folder_translation_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/translation_style_button"
                        android:textAllCaps="false" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/folder_language_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:maxWidth="360dp"
                        android:text="@string/folder_language_setting"
                        android:textAlignment="center"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folder_reading_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/folder_reading_settings"
                        android:textAppearance="@style/Widget.MangaTranslator.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/folder_reading_settings_hint"
                        android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/folder_reading_mode_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:maxWidth="360dp"
                        android:text="@string/folder_reading_mode_setting"
                        android:textAlignment="center"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_pages_label"
                        android:textAppearance="@style/Widget.MangaTranslator.SectionLabel" />

                    <LinearLayout
                        android:id="@+id/folder_status_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/folder_progress_left"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

                        <TextView
                            android:id="@+id/folder_progress_right"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
                    </LinearLayout>


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/folder_chapter_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/folder_image_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/folder_images_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/folder_images_empty"
                        android:textAppearance="@style/Widget.MangaTranslator.BodyMuted"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.manga.translate.platform.SafeNestedScrollView>

        <LinearLayout
            android:id="@+id/folder_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/folder_back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/folder_back" />

            <TextView
                android:id="@+id/folder_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textAppearance="@style/Widget.MangaTranslator.Title" />
        </LinearLayout>
    </FrameLayout>


    <LinearLayout
        android:id="@+id/library_selection_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/library_selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/library_translate_selected"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/translate_selected"
                app:tint="?attr/colorAccent"
                app:srcCompat="@drawable/ic_selection_translate" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/library_delete_selected"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/folder_delete"
                app:tint="?attr/colorError"
                app:srcCompat="@drawable/ic_delete_outline" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/library_select_all"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/select_all"
                app:srcCompat="@drawable/ic_selection_all" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/library_cancel_selection"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/cancel_selection"
                app:srcCompat="@drawable/ic_selection_close" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/folder_selection_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/folder_selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/folder_retranslate_selected"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/retranslate_selected"
                app:tint="?attr/colorAccent"
                app:srcCompat="@drawable/ic_selection_translate" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/folder_delete_selected"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/folder_delete"
                app:tint="?attr/colorError"
                app:srcCompat="@drawable/ic_delete_outline" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/folder_select_all"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/select_all"
                app:srcCompat="@drawable/ic_selection_all" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/folder_cancel_selection"
                style="@style/Widget.MangaTranslator.SelectionIcon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/cancel_selection"
                app:srcCompat="@drawable/ic_selection_close" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_folder_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/create_folder"
        android:src="@android:drawable/ic_input_add"
        android:rotation="-3"
        app:backgroundTint="?attr/buttonFillColor"
        app:elevation="5dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MangaTranslator.StickerFab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="?attr/buttonTextColor" />

</androidx.constraintlayout.widget.ConstraintLayout>
