<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reading_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reading_webtoon_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:visibility="gone" />

    <com.manga.translate.reader.ReadingScrollView
        android:id="@+id/reading_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/reading_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.manga.translate.reader.ReadingRegionImageView
                android:id="@+id/reading_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/preview_image"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/reading_transition_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/preview_image"
                android:scaleType="matrix"
                android:visibility="gone" />

            <com.manga.translate.reader.FloatingTranslationView
                android:id="@+id/translation_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </com.manga.translate.reader.ReadingScrollView>

    <TextView
        android:id="@+id/reading_page_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_reader_label"
        android:padding="9dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/reading_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/reading_empty"
        android:textColor="?attr/mutedTextColor"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/reading_edit_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_reader_label"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/reading_add_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reading_add_bubble"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_input_add" />

        <ImageButton
            android:id="@+id/reading_clear_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reading_clear_bubbles"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete_outline"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/reading_edit_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reading_edit_bubbles"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_edit" />

        <ImageButton
            android:id="@+id/reading_cancel_edit_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reading_cancel_edit"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reading_bubble_size_floating_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_reader_label"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/reading_bubble_size_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reading_bubble_size_minus"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bubble_minus" />

        <ImageButton
            android:id="@+id/reading_bubble_size_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reading_bubble_size_plus"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bubble_plus" />
    </LinearLayout>

</FrameLayout>
