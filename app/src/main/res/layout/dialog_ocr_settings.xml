<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/use_local_ocr_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/dialogTextColor"
            android:text="@string/ocr_use_local" />

        <TextView
            android:id="@+id/api_ocr_supplement_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/dialogTextColor"
            android:text="@string/ocr_api_supplement" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/api_ocr_supplement_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ocr_api_supplement"
            android:max="3" />

        <TextView
            android:id="@+id/api_ocr_supplement_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/manual_bubbles_api_ocr_switch"
            android:singleLine="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/dialogTextColor"
            android:text="@string/ocr_manual_api" />

        <TextView
            android:id="@+id/ocr_settings_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ocr_settings_note_local"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ocr_api_format_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ocr_api_format_hint"
            app:endIconMode="dropdown_menu"
            android:visibility="gone">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:id="@+id/ocr_api_format_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:importantForAutofill="no"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ocr_api_url_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ocr_api_url_hint"
            app:placeholderTextColor="?attr/dialogHintTextColor"
            app:placeholderText="@string/ocr_api_reuse_main_hint">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:id="@+id/ocr_api_url_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ocr_api_key_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ocr_api_key_hint"
            app:placeholderTextColor="?attr/dialogHintTextColor"
            app:placeholderText="@string/ocr_api_reuse_main_hint">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:id="@+id/ocr_api_key_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ocr_model_name_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ocr_model_name_hint"
            app:placeholderTextColor="?attr/dialogHintTextColor"
            app:placeholderText="@string/ocr_api_reuse_main_hint">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:id="@+id/ocr_model_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ocr_api_timeout_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ocr_api_timeout_hint">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:id="@+id/ocr_api_timeout_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ocr_api_concurrency_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ocr_api_concurrency_hint"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:id="@+id/ocr_api_concurrency_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
