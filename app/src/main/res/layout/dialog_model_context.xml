<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/model_context_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/model_context_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/context_input_input"
            android:text="@string/model_context_input"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/context_input_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/context_input_input"
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/context_output_input"
            android:text="@string/model_context_output"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/context_output_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/context_output_input"
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/context_total_input"
            android:text="@string/model_context_total"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/context_total_layout"
            style="@style/Widget.MangaTranslator.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/context_total_input"
                style="@style/Widget.MangaTranslator.DialogEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/model_context_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/model_context_note"
            android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />
    </LinearLayout>
</ScrollView>
