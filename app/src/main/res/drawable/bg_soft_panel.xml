<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#30000000" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="?attr/surfaceAltColor" />
            <stroke android:width="1dp" android:color="?attr/outlineColor" />
        </shape>
    </item>
    <item android:id="@+id/card_accent_strip" android:width="4dp" android:gravity="left" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/cardStripeColor" />
        </shape>
    </item>
</layer-list>
