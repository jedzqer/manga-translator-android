<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:left="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#22000000" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/surfaceAltColor" />
                    <corners android:radius="2dp" />
                    <stroke android:width="1dp" android:color="?attr/outlineColor" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#26000000" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/buttonFillPressedColor" />
                    <corners android:radius="2dp" />
                    <stroke android:width="1dp" android:color="?attr/outlineColor" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="2dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#30000000" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/buttonFillColor" />
                    <corners android:radius="2dp" />
                    <stroke android:width="1dp" android:color="?attr/outlineColor" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
