<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp" android:right="2dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="5dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="?attr/heroStartColor" />
            <stroke android:width="1dp" android:color="?attr/outlineColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:height="44dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
